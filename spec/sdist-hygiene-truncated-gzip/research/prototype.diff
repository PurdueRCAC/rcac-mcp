+    hidden = tar_bytes([*CLEAN, f'{ROOT}/.security/hidden.md', f'{ROOT}/src/z.py'])
+    bad_header = bytearray(hidden)
+    at = header_at(hidden, f'{ROOT}/.security/hidden.md')
+    bad_header[at + 148 : at + 156] = b'0000000\x00'
